# 摄像头初始配置：只保存在本机，不会进入镜像或分析数据库
# 首次启动后也可直接在 Web「设置 → 摄像头」中测试并保存；Web 配置优先于以下初始值
CAMERA_STREAM_URL=http://192.168.1.80:2345/
CAMERA_USERNAME=
CAMERA_PASSWORD=
CAMERA_AUTH_TYPE=basic
# 若设备用网页登录而非 Basic/Digest，可在登录后临时填 Cookie；不要提交到 Git
CAMERA_COOKIE=
CAMERA_VERIFY_TLS=true
CAMERA_SETTINGS_PATH=/app/data/camera-settings.json

# auto: 有 models/yolov8n.onnx 时使用 YOLO，否则回退到 HOG
DETECTOR_MODE=auto
DETECTOR_INPUT_SIZE=320
OPENCV_THREADS=2
TZ=Asia/Shanghai

# Bark App 首页测试链接中的 key；也可改为自建 Bark Server
BARK_SERVER=https://api.day.app
BARK_DEVICE_KEY=
# 可选：同时发送到一个接收 {title, body, group} JSON 的 Webhook
GENERIC_WEBHOOK_URL=
LOG_LEVEL=INFO
